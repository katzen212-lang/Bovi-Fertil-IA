import streamlit as st
import cv2
import numpy as np
from PIL import Image

st.set_page_config(
    page_title="BOVI-SEMEN AI",
    page_icon="🔬",
    layout="wide"
)

st.title("🔬 BOVI-SEMEN AI")
st.subheader("Análisis seminal bovino")

st.write(
    "Bienvenido al sistema de análisis "
    "microscópico bovino."
)

st.sidebar.header("Menú principal")

seccion = st.sidebar.selectbox(
    "Seleccionar módulo",
    [
        "Inicio",
        "Análisis de muestras",
        "Historial",
        "Configuración"
    ]
)

if seccion == "Inicio":

    st.success("Sistema iniciado correctamente.")

    st.info(
        "Estamos construyendo nuestro "
        "primer prototipo de inteligencia artificial."
    )

elif seccion == "Análisis de muestras":

    st.header("Análisis microscópico")

    archivo = st.file_uploader(
        "Seleccionar fotografía del microscopio",
        type=["jpg", "jpeg", "png"]
    )

    if archivo:

        imagen = Image.open(archivo).convert("RGB")

        st.image(
            imagen,
            caption="Fotografía original",
            use_container_width=True
        )

        st.success("Imagen cargada correctamente.")

elif seccion == "Historial":

    st.header("Historial de muestras")
    st.info("Aquí guardaremos los análisis.")

elif seccion == "Configuración":

    st.header("Configuración del sistema")
    st.write("Versión experimental 1.0")